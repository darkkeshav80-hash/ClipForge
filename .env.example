# ==============================================================================
# CLIPFORGE AI — LOCAL CONFIGURATION (.env)
# ==============================================================================

# Server Configuration
HOST=127.0.0.1
PORT=8000
FRONTEND_PORT=3000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Storage Paths (Relative to clipforge-ai root or absolute)
STORAGE_DIR=storage
MODELS_DIR=models
LOGS_DIR=logs
DATABASE_PATH=storage/clipforge.db

# Hardware Profile: ECO | BALANCED | QUALITY
HARDWARE_PROFILE=BALANCED
FFMPEG_THREADS=4
MAX_CONCURRENT_JOBS=1
ENABLE_GPU_ACCELERATION=false

# AI Provider API Keys (Leave blank if using Free / Ollama mode)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Default Models
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_WHISPER_MODEL=base

# YouTube Studio Data API v3 (Optional, for auto-publishing)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/youtube/callback
