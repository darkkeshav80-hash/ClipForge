{
  "app_name": "CLIPFORGE AI",
  "version": "1.0.0",
  "hardware_profile": "BALANCED",
  "low_performance_mode": false,
  "max_ram_usage_gb": 12,
  "ffmpeg_threads": 4,
  "whisper_model": "base",
  "analysis_resolution": "480p",
  "enable_gpu": false,
  "max_concurrent_jobs": 1,
  "storage_dir": "storage",
